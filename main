// CONFIGURAÇÕES GLOBAIS
// ====================================================================

const CONFIG = {
  ABA_TEMPLATES: '💾 Meus Templates',
  ABA_RELATORIO: '📊 Relatório de Envios',
  ABA_RASTREAMENTO: '📊 Rastreamento Detalhado',
  ABA_DADOS: 'Contatos',
  NOME_REMETENTE: 'JR Contabilidade', 
  DELAY_ENVIO_MS: 1500,
  TAMANHO_LOTE: 20,
  TEMPO_LOTE_MS: 60000,
  MISSING_VAR_FALLBACK: '',
  CORES_LOG: {
    SUCESSO: '#d9ead3',
    ERRO: '#f4cccc',
    ABERTO: '#c9daf8'
  },
  // ADICIONE ESTA LINHA ABAIXO COM O SEU LINK DA IMPLANTAÇÃO:
  URL_WEB_APP: "https://script.google.com/macros/s/AKfycbwm5zzO0ywGL2LUZiriyLU4gdT4BOqKrLgSva7AxZbiqhnPu01Yn0XcyeufhO2-0pNmzw/exec"
};

// ====================================================================
// WEB APP - RASTREAMENTO DE ABERTURA
// ====================================================================

function doGet(e) {
  try {
    const id = e && e.parameter && e.parameter.id;
    if (id) {
      registrarAbertura(id);
    }
  } catch (err) {
    console.error("Erro no rastreamento: " + err);
  }
  // Compatibilidade legada: HtmlOutput não é uma resposta image/gif.
  // O handler pode registrar a requisição, mas não garante um pixel carregável.
  const pixelBase64 = "R0lGODlhAQABAPAAAAAAAAAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==";
  return HtmlService.createHtmlOutput(`<img src="data:image/gif;base64,${pixelBase64}" alt="" />`);
}

function registrarAbertura(id) {
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const planilhaId = PropertiesService.getScriptProperties().getProperty('RASTREAMENTO_PLANILHA_ID');
    const ss = planilhaId ? SpreadsheetApp.openById(planilhaId) : SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) return;
    const sheet = ss.getSheetByName(CONFIG.ABA_RASTREAMENTO);
    if (!sheet) return;
  
    const COL_ID = 7;
    const COL_STATUS = 4;
    const COL_1_LEITURA = 5;
    const COL_ULT_LEITURA = 6;

    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
  
    const idRange = sheet.getRange(2, COL_ID + 1, lastRow - 1, 1);
    const encontrado = idRange.createTextFinder(String(id)).matchEntireCell(true).findNext();
    if (!encontrado) return;
  
    const linha = encontrado.getRow();
    const dataAgora = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
    const primeiraLeitura = sheet.getRange(linha, COL_1_LEITURA + 1).getValue();
  
    if (!primeiraLeitura || primeiraLeitura === "") {
      sheet.getRange(linha, COL_1_LEITURA + 1).setValue(dataAgora);
    }

    sheet.getRange(linha, COL_ULT_LEITURA + 1).setValue(dataAgora);
    sheet.getRange(linha, COL_STATUS + 1).setValue("LIDO / ABERTO").setBackground(CONFIG.CORES_LOG.ABERTO);
  } finally {
    lock.releaseLock();
  }
}

// ====================================================================
// MENU E INICIALIZAÇÃO
// ====================================================================

function onOpen() {
  const ui = SpreadsheetApp.getUi();
  ui.createMenu('Auto Email')
    .addItem('📧 Abrir Painel de Envio', 'abrirPainel')
    .addSeparator()
    .addItem('🛠️ Configurar Rastreamento (1ª vez)', 'mostrarUrlRastreamento')
    .addToUi();
    
  ocultarAbaTemplates();
}

function ocultarAbaTemplates() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.ABA_TEMPLATES);
  if (sheet && !sheet.isSheetHidden()) {
    sheet.hideSheet();
  }
}

function abrirPainel() {
  const template = HtmlService.createTemplateFromFile('painel');
  template.userEmail = Session.getActiveUser().getEmail();
  
  const html = template.evaluate()
    .setWidth(1150)
    .setHeight(850)
    .setTitle('📧 Editor e Envio');
    
  SpreadsheetApp.getUi().showModalDialog(html, 'Auto Email');
}

function mostrarUrlRastreamento() {
  try {
    const url = getTrackingUrl();
    if (url) {
      Browser.msgBox("Status do Rastreamento", `URL configurada (não garante a detecção de aberturas; consulte as limitações no manual).\nURL do Web App: ${url}`, Browser.Buttons.OK);
    } else {
      Browser.msgBox("Atenção", "O rastreamento ainda não está ativo. Você precisa implantar este script como 'App da Web'. Veja o manual.", Browser.Buttons.OK);
    }
  } catch (e) {
    Browser.msgBox("Erro", "Não foi possível obter a URL. Certifique-se de implantar como App da Web.", Browser.Buttons.OK);
  }
}

// ====================================================================
// DADOS E LEITURA DA PLANILHA
// ====================================================================

function getVariaveisDisponiveis() {
  const dados = getSheetDataComFiltro();
  if (!dados || dados.length === 0) return [];
  return dados[0].map(header => String(header).replace(/\s+/g, " ").trim());
}

function contarDestinatarios() {
  const dados = getSheetDataComFiltro();
  return (dados && dados.length > 1) ? dados.length - 1 : 0;
}

function getSheetDataComFiltro() {
  const sheet = getSheetDados();
  const range = sheet.getDataRange();
  const values = range.getValues();
  if (!sheet.getFilter()) return values;
  
  const visibleData = [];
  const startRow = range.getRow();
  visibleData.push(values[0]); 
  
  for (let i = 1; i < values.length; i++) {
    if (!sheet.isRowHiddenByFilter(startRow + i)) {
      visibleData.push(values[i]);
    }
  }
  return visibleData;
}

function getSheetDados() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (CONFIG.ABA_DADOS) {
    const sheet = ss.getSheetByName(CONFIG.ABA_DADOS);
    if (sheet) return sheet;
  }
  return ss.getActiveSheet();
}

// ====================================================================
// GESTÃO DE TEMPLATES (HÍBRIDO DRIVE + PLANILHA)
// ====================================================================

function getPastaTemplates() {
  const NOME_PASTA = "Templates AutoEmail (Sistema)";
  const pastas = DriveApp.getFoldersByName(NOME_PASTA);
  if (pastas.hasNext()) {
    return pastas.next();
  } else {
    return DriveApp.createFolder(NOME_PASTA);
  }
}

function salvarNovoTemplate(nomeOriginal, nomeNovo, assunto, html) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName(CONFIG.ABA_TEMPLATES);
    
    if (!sheet) {
      sheet = ss.insertSheet(CONFIG.ABA_TEMPLATES);
      sheet.appendRow(['Nome', 'Assunto', 'Conteudo', 'Data Atualização']);
      sheet.getRange("A1:D1").setFontWeight("bold");
      sheet.setColumnWidth(3, 50);
      sheet.hideSheet();
    }

    const dados = sheet.getDataRange().getValues();
    let linhaParaAtualizar = -1;
    let conteudoAntigo = "";
    const chaveBusca = nomeOriginal ? nomeOriginal : nomeNovo;

    for (let i = 1; i < dados.length; i++) {
      if (dados[i][0] === chaveBusca) { 
        linhaParaAtualizar = i + 1;
        conteudoAntigo = String(dados[i][2]);
        break; 
      }
    }

    let conteudoFinal = html;
    
    if (html.length > 45000) {
      const pasta = getPastaTemplates();
      const nomeSeguro = sanitizeFileName(nomeNovo);
      const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyyMMdd_HHmmss");
      const arquivo = pasta.createFile(`Template_${nomeSeguro}_${timestamp}.html`, html, MimeType.HTML);
      conteudoFinal = "DRIVE:" + arquivo.getId();
    }

    const timestampData = new Date();
    
    if (linhaParaAtualizar > 0) {
      sheet.getRange(linhaParaAtualizar, 1, 1, 4).setValues([[nomeNovo, assunto, conteudoFinal, timestampData]]);
      // Só descarte o arquivo anterior depois de persistir o novo conteúdo.
      if (conteudoAntigo.startsWith("DRIVE:")) {
        try {
          const idAntigo = conteudoAntigo.split(":")[1];
          DriveApp.getFileById(idAntigo).setTrashed(true);
        } catch(e) { }
      }
      return { success: true, message: `Template "${nomeNovo}" atualizado com sucesso!` };
    } else {
      sheet.appendRow([nomeNovo, assunto, conteudoFinal, timestampData]);
      return { success: true, message: `Template "${nomeNovo}" salvo com sucesso!` };
    }

  } catch (e) { 
    console.error(e);
    return { success: false, message: `Erro ao salvar: ${e.message}` };
  }
}

function renomearTemplateBackend(nomeAntigo, nomeNovo) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(CONFIG.ABA_TEMPLATES);
    if (!sheet) throw new Error('Base de templates não encontrada.');
    
    const dados = sheet.getDataRange().getValues();
    const existe = dados.some((row, index) => index > 0 && String(row[0]).trim() === nomeNovo.trim());
    
    if (existe) {
       return { success: false, message: "Já existe um template com esse nome." };
    }

    for (let i = 1; i < dados.length; i++) {
      if (String(dados[i][0]).trim() === String(nomeAntigo).trim()) { 
        sheet.getRange(i + 1, 1).setValue(nomeNovo);
        sheet.getRange(i + 1, 4).setValue(new Date()); 
        return { success: true, message: "Template renomeado com sucesso!" };
      }
    }
    return { success: false, message: 'Template original não encontrado.' };
  } catch (e) {
    return { success: false, message: e.message };
  }
}

function listarMeusTemplates() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.ABA_TEMPLATES);
  if (!sheet) return [];
  return sheet.getDataRange().getValues().slice(1).map(row => row[0]).filter(nome => nome);
}

function carregarTemplateEspecifico(nome) {
  try {
    if (!nome || typeof nome !== 'string') throw new Error('Nome de template inválido');
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(CONFIG.ABA_TEMPLATES);
    if (!sheet) throw new Error('Base de templates não encontrada.');
    
    const dados = sheet.getDataRange().getValues();
    const templateRow = dados.slice(1).find(row => String(row[0]).trim() === String(nome).trim());
    
    if (templateRow) {
      let corpo = String(templateRow[2] || '');
      
      if (corpo.startsWith("DRIVE:")) {
        try {
          const id = corpo.split(":")[1];
          corpo = DriveApp.getFileById(id).getBlob().getDataAsString();
        } catch (err) {
          corpo = "<p style='color:red'>Erro: O arquivo deste template foi deletado do Google Drive.</p>";
        }
      }

      return {
        success: true,
        message: 'Template carregado',
        assunto: String(templateRow[1] || ''),
        corpo: corpo
      };
    }
    return { success: false, message: 'Template não encontrado' };
  } catch (e) {
    console.error(e);
    return { success: false, message: `Erro: ${e.message}` };
  }
}

function excluirTemplate(nome) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.ABA_TEMPLATES);
  if (!sheet) return { success: false, message: 'Aba não encontrada' };

  const dados = sheet.getDataRange().getValues();
  for (let i = 1; i < dados.length; i++) {
    if (dados[i][0] === nome) { 
      const conteudo = String(dados[i][2]);
      
      if (conteudo.startsWith("DRIVE:")) {
        try {
          const id = conteudo.split(":")[1];
          DriveApp.getFileById(id).setTrashed(true);
        } catch(e) {}
      }

      sheet.deleteRow(i + 1);
      return { success: true }; 
    }
  }
  return { success: false, message: 'Template não encontrado para exclusão' };
}

// ====================================================================
// IMPORTAÇÃO E EXPORTAÇÃO JSON
// ====================================================================

function exportarTemplatesLista(nomesArray) {
  try {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const sheet = ss.getSheetByName(CONFIG.ABA_TEMPLATES);
      if (!sheet) return { success: true, data: [] };
      
      const dados = sheet.getDataRange().getValues();
      const templates = [];
      
      for(let i = 1; i < dados.length; i++) {
         const nomeAtual = String(dados[i][0]);
         if (nomesArray.includes(nomeAtual)) {
             let corpo = String(dados[i][2]);
             
             if(corpo.startsWith("DRIVE:")) {
                 try {
                     const id = corpo.split(":")[1];
                     corpo = DriveApp.getFileById(id).getBlob().getDataAsString();
                 } catch(e) {
                     continue;
                 }
             }
             
             templates.push({
                 nome: nomeAtual,
                 assunto: String(dados[i][1]),
                 corpo: corpo
             });
         }
      }
      return { success: true, data: templates };
  } catch (e) {
      return { success: false, message: e.message };
  }
}

function importarTemplatesGeral(listaTemplates) {
  try {
     if (!Array.isArray(listaTemplates)) throw new Error("Formato de templates inválido.");
     let adicionados = 0;
     for(let t of listaTemplates) {
        if(t && typeof t.nome === 'string' && t.nome.trim() && typeof t.corpo === 'string' && t.corpo) {
           const resultado = salvarNovoTemplate(t.nome, t.nome, t.assunto || '', t.corpo);
           if (!resultado.success) {
             throw new Error(`${adicionados} templates importados antes da falha. ${resultado.message}`);
           }
           adicionados++;
        }
     }
     return { success: true, message: adicionados + " templates importados com sucesso!" };
  } catch(e) {
     return { success: false, message: "Erro na importação: " + e.message };
  }
}

// ====================================================================
// ENVIO E PREVIEW DE EMAILS
// ====================================================================

function enviarEmailTeste(html, assunto, destinatario, anexosBase64, imagensInline) {
  try {
    if (!destinatario || !destinatario.includes('@')) throw new Error("E-mail de teste inválido.");
    
    const dados = getSheetDataComFiltro();
    let corpoFinal = html;
    let assuntoFinal = assunto;
    
    if (dados.length > 1) {
      const cabecalhos = dados[0];
      const linhaTeste = dados[1];
      corpoFinal = personalizarTexto(html, cabecalhos, linhaTeste);
      assuntoFinal = personalizarTexto(assunto, cabecalhos, linhaTeste);
    }

    const htmlTeste = `${corpoFinal}<br><br><hr><p style="color:#666; font-size:11px; font-family:sans-serif;">⚠️ [MODO TESTE] Exemplo com dados da 1ª linha visível.</p>`;
    
    const options = {
      htmlBody: htmlTeste,
      name: CONFIG.NOME_REMETENTE
    };
    
    if (anexosBase64 && anexosBase64.length > 0) {
      options.attachments = processarBlobs(anexosBase64);
    }

    if (imagensInline && imagensInline.length > 0) {
      options.inlineImages = prepararBlobsInline(imagensInline);
    }

    GmailApp.sendEmail(destinatario, `[TESTE] ${assuntoFinal}`, "Seu cliente de email não suporta HTML.", options);
    return { success: true, message: `✅ Teste enviado com sucesso para: ${destinatario}` };
  } catch (e) { 
    return { success: false, message: `Erro no envio de teste: ${e.message}` };
  }
}

// O conteúdo grande fica no Drive; apenas o checkpoint pequeno fica em UserProperties.
// Helpers terminados em "_" não podem ser chamados por google.script.run.
function chaveEnvio_() {
  return 'AUTOEMAIL_ENVIO_' + SpreadsheetApp.getActiveSpreadsheet().getId();
}

function lerEnvio_() {
  const value = PropertiesService.getUserProperties().getProperty(chaveEnvio_());
  return value ? JSON.parse(value) : null;
}

function salvarEnvio_(job) {
  PropertiesService.getUserProperties().setProperty(chaveEnvio_(), JSON.stringify(job));
}

function comLockEnvio_(callback) {
  const lock = LockService.getUserLock();
  if (!lock.tryLock(1000)) return { success: false, message: 'Já existe um lote em processamento. Aguarde e reabra o painel para retomar.' };
  try {
    return callback();
  } catch (e) {
    console.error(e);
    return { success: false, message: 'Envio interrompido: ' + e.message + '\nReabra o painel para consultar e retomar o checkpoint salvo.' };
  } finally {
    lock.releaseLock();
  }
}

function destinatariosDaLinha_(valor, ccGlobal) {
  const emails = String(valor || '').split(/[;,]/).map(e => e.trim()).filter(isValidEmail);
  if (!emails.length) return { para: '', cc: [], quantidade: 0 };
  const cc = [...new Set([...emails.slice(1), ...ccGlobal])];
  // Conta conservadora: o Gmail pode descontar também endereços repetidos entre Para e CC.
  return { para: emails[0], cc: cc, quantidade: 1 + cc.length };
}

function respostaEnvio_(job, pausado, mensagem) {
  return {
    success: true, pending: true, paused: !!pausado, jobId: job.id,
    processados: job.cursor, total: job.total,
    message: mensagem || `Enviando: ${job.cursor} / ${job.total}`
  };
}

function getEnvioPendente() {
  const job = lerEnvio_();
  return job ? respostaEnvio_(job, true,
    `Há um envio pendente: ${job.cursor} / ${job.total} linhas processadas. Retomar usando os dados originais?` +
    (job.emVoo !== null ? `\nO registro visível ${job.emVoo + 1} tem resultado incerto e NÃO será reenviado automaticamente. Confira a pasta Enviados.` : '')) : null;
}

function executarEnvioEmMassa(htmlFinal, assuntoFinal, ccGlobalString, anexosBase64, imagensInline) {
  return comLockEnvio_(() => {
    const existente = lerEnvio_();
    if (existente) return respostaEnvio_(existente, true, 'Já existe um envio pendente. Retomar os dados originais?');
    const dados = getSheetDataComFiltro();
    if (!dados || dados.length < 2) return { success: false, message: 'Nenhuma linha visível para envio.' };
    const indexEmail = identificarColunaEmail(dados[0]);
    if (indexEmail === -1) return { success: false, message: 'Erro: Coluna "Email" ou "E-mail" não encontrada.' };
    const cc = String(ccGlobalString || '').split(/[,;]/).map(e => e.trim()).filter(isValidEmail);
    const quantidade = dados.slice(1).reduce((total, linha) => total + destinatariosDaLinha_(linha[indexEmail], cc).quantidade, 0);
    const cota = MailApp.getRemainingDailyQuota();
    if (quantidade > cota) return { success: false, message:
      `⛔ OPERAÇÃO CANCELADA POR SEGURANÇA\nCota restante: ${cota} destinatários. Necessários (incluindo CC por mensagem): ${quantidade}.` };
    // Datas continuam com a mesma representação usada por personalizarTexto, mesmo após JSON.
    const snapshot = dados.map(row => row.map(value => value instanceof Date
      ? Utilities.formatDate(value, Session.getScriptTimeZone(), 'dd/MM/yyyy') : value));
    const payload = { dados: snapshot, html: htmlFinal, assunto: assuntoFinal, cc: cc,
      anexos: anexosBase64 || [], imagens: imagensInline || [], trackingUrl: getTrackingUrl() };
    // Valide anexos antes de criar um trabalho persistente.
    processarBlobs(payload.anexos);
    prepararBlobsInline(payload.imagens);
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    PropertiesService.getScriptProperties().setProperty('RASTREAMENTO_PLANILHA_ID', ss.getId());
    const id = Utilities.getUuid();
    // createFile(blob) evita o limite de 10 MB da sobrecarga textual, inclusive com anexos em Base64.
    const file = DriveApp.createFile(Utilities.newBlob(JSON.stringify(payload), 'application/json', 'AutoEmail_Envio_' + id + '.json'));
    const job = { id: id, fileId: file.getId(), cursor: 0, total: dados.length - 1,
      sucesso: 0, erro: 0, avisos: [], emVoo: null };
    try {
      salvarEnvio_(job);
    } catch (e) {
      file.setTrashed(true);
      throw e;
    }
    return processarLote_(job);
  });
}

function continuarEnvioEmMassa(jobId) {
  return comLockEnvio_(() => {
    const job = lerEnvio_();
    if (!job || job.id !== jobId) return { success: false, message: 'Envio não encontrado ou já concluído.' };
    return processarLote_(job);
  });
}

function avisoEnvio_(job, mensagem, prioritario) {
  // Limite por valor em UserProperties: retenha até dez avisos curtos.
  // Resultados incertos têm prioridade sobre avisos de rastreamento.
  if (prioritario && job.avisos.length >= 10) job.avisos.pop();
  if (job.avisos.length < 10) job.avisos.push(String(mensagem).slice(0, 120));
}

function avisarProgressoEnvio_(job, finalizado) {
  try {
    SpreadsheetApp.getActiveSpreadsheet().toast(
      finalizado ? 'Processo finalizado!' : `Progresso: ${Math.round(job.cursor / job.total * 100)}%`,
      finalizado ? '✅ Concluído' : '🚀 Enviando...', finalizado ? 5 : 3);
  } catch (e) {
    console.error('Não foi possível exibir o progresso: ' + e);
  }
}

function processarLote_(job) {
  const inicio = Date.now();
  const file = DriveApp.getFileById(job.fileId);
  const payload = JSON.parse(file.getBlob().getDataAsString());
  const cabecalhos = payload.dados[0];
  const linhas = payload.dados.slice(1);
  const indexEmail = identificarColunaEmail(cabecalhos);
  const indexEmpresa = cabecalhos.findIndex(h => /^(empresa|raz[aã]o\s?social|cliente)$/i.test(String(h).trim()));
  const arquivos = processarBlobs(payload.anexos);
  const imagens = prepararBlobsInline(payload.imagens);
  // Se a execução anterior terminou entre o envio e o checkpoint, não arrisque duplicar.
  if (job.emVoo !== null) {
    avisoEnvio_(job, `Registro visível ${job.emVoo + 1}: resultado incerto. Confira Enviados; não reenviado.`, true);
    job.erro++;
    job.cursor = job.emVoo + 1;
    job.emVoo = null;
    salvarEnvio_(job);
  }
  let processados = 0;
  while (job.cursor < linhas.length && processados < CONFIG.TAMANHO_LOTE && Date.now() - inicio < CONFIG.TEMPO_LOTE_MS) {
    const i = job.cursor;
    const linha = linhas[i];
    const dest = destinatariosDaLinha_(linha[indexEmail], payload.cc);
    if (!dest.quantidade) {
      job.erro++;
      avisoEnvio_(job, `Registro visível ${i + 1}: Nenhum e-mail válido encontrado.`);
      job.cursor++;
      salvarEnvio_(job);
      processados++;
      if (processados % 5 === 0) avisarProgressoEnvio_(job, false);
      continue;
    }
    if (MailApp.getRemainingDailyQuota() < dest.quantidade) {
      return respostaEnvio_(job, true, 'Cota insuficiente para a próxima mensagem. O envio está salvo. Retome quando houver cota.');
    }
    let corpo = personalizarTexto(payload.html, cabecalhos, linha);
    const assunto = personalizarTexto(payload.assunto, cabecalhos, linha);
    const trackingId = payload.trackingUrl ? Utilities.getUuid() : '';
    if (trackingId) {
      const separador = payload.trackingUrl.includes('?') ? '&' : '?';
      const url = payload.trackingUrl + separador + 'id=' + encodeURIComponent(trackingId);
      corpo += `<img src="${url.replace(/&/g, '&amp;').replace(/"/g, '&quot;')}" width="1" height="1" style="border:0;" alt="" />`;
    }
    const options = { htmlBody: corpo, name: CONFIG.NOME_REMETENTE };
    if (dest.cc.length) options.cc = dest.cc.join(',');
    if (arquivos.length) options.attachments = arquivos;
    if (Object.keys(imagens).length) options.inlineImages = imagens;
    job.emVoo = i;
    salvarEnvio_(job); // Antes de chamar o Gmail, nunca depois.
    try {
      GmailApp.sendEmail(dest.para, assunto, 'Email em formato HTML.', options);
    } catch (e) {
      // Até um erro de rede pode ocorrer após o Gmail aceitar a mensagem.
      return respostaEnvio_(job, true, `Tentativa interrompida no registro visível ${i + 1} (${dest.para}): ` + String(e.message).slice(0, 250) +
        '\nConfira a pasta Enviados. Ao retomar, esta tentativa será ignorada para evitar duplicação.');
    }
    job.sucesso++;
    job.cursor++;
    job.emVoo = null;
    salvarEnvio_(job);
    // Uma falha no relatório não transforma mensagem já enviada em falha de envio.
    if (trackingId) {
      try {
        registrarEnvioIndividual(trackingId, [dest.para, ...dest.cc].join('; '),
          indexEmpresa > -1 ? linha[indexEmpresa] || '-' : '-', assunto, 'ENVIADO');
      } catch (e) {
        avisoEnvio_(job, `Registro visível ${i + 1}: enviado, mas falhou o registro de rastreamento.`);
        salvarEnvio_(job);
      }
    }
    processados++;
    if (processados % 5 === 0) avisarProgressoEnvio_(job, false);
    Utilities.sleep(CONFIG.DELAY_ENVIO_MS);
  }
  if (job.cursor < linhas.length) return respostaEnvio_(job, false);
  // Se o relatório falhar, o cursor final persistido impede novos envios na retomada.
  registrarLogBatch(payload.assunto, job.total, job.sucesso, job.erro, job.avisos);
  PropertiesService.getUserProperties().deleteProperty(chaveEnvio_());
  try { file.setTrashed(true); } catch (e) { console.error('Não foi possível remover o snapshot: ' + e); }
  avisarProgressoEnvio_(job, true);
  return { success: true, message:
    `✅ Processamento Finalizado!\n\n📤 Enviados: ${job.sucesso}\n❌ Falhas ou resultados incertos: ${job.erro}` +
    (job.avisos.length ? '\n\nAvisos (até 10):\n' + job.avisos.join('\n') : '') +
    (payload.trackingUrl ? `\n\n👁️ Registros: aba "${CONFIG.ABA_RASTREAMENTO}". A detecção depende do cliente de e-mail e da limitação do endpoint HTML do Apps Script.`
      : '\n\n⚠️ Rastreamento não configurado.') };
}

function cancelarEnvioEmMassa(jobId) {
  return comLockEnvio_(() => {
    const job = lerEnvio_();
    if (!job || job.id !== jobId) return { success: false, message: 'Envio não encontrado ou já concluído.' };
    let file;
    let assunto = 'Envio ' + job.id;
    try {
      file = DriveApp.getFileById(job.fileId);
      assunto = JSON.parse(file.getBlob().getDataAsString()).assunto;
    } catch (e) {
      avisoEnvio_(job, 'Snapshot indisponível no cancelamento: ' + e.message);
    }
    registrarLogBatch(assunto, job.total, job.sucesso, job.erro,
      [...job.avisos, `Cancelado. Restavam ${job.total - job.cursor} registros; tentativa em andamento: ${job.emVoo !== null ? 'resultado incerto, confira Enviados' : 'não'}.`]);
    PropertiesService.getUserProperties().deleteProperty(chaveEnvio_());
    try { if (file) file.setTrashed(true); } catch (e) { console.error(e); }
    return { success: true, message: 'Envio cancelado. Mensagens já enviadas não foram desfeitas.' };
  });
}

// ====================================================================
// FUNÇÕES DE LOG E RASTREAMENTO
// ====================================================================

function registrarEnvioIndividual(id, destinatarios, empresa, assunto, status) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(CONFIG.ABA_RASTREAMENTO);
  
  if (!sheet) {
    sheet = ss.insertSheet(CONFIG.ABA_RASTREAMENTO);
    const headers = ['Data Envio', 'Destinatário', 'Empresa', 'Assunto', 'Status Atual', 'Data da 1ª Leitura', 'Data da Última Leitura', 'ID'];
    sheet.appendRow(headers);
    sheet.getRange("A1:H1").setFontWeight("bold").setBackground("#c9daf8");
    sheet.setFrozenRows(1);
    
    sheet.setColumnWidth(1, 130); 
    sheet.setColumnWidth(2, 250); 
    sheet.setColumnWidth(3, 200); 
    sheet.setColumnWidth(4, 250); 
    sheet.setColumnWidth(5, 120); 
    sheet.setColumnWidth(6, 130); 
    sheet.setColumnWidth(7, 130); 
    sheet.setColumnWidth(8, 280);
  }
  
  const dataHora = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
  sheet.appendRow([dataHora, destinatarios, empresa, assunto, status, "", "", id]);
}

function registrarLogBatch(assunto, total, sucessos, erros, detalhesArray) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(CONFIG.ABA_RELATORIO);
  
  if (!sheet) { 
    sheet = ss.insertSheet(CONFIG.ABA_RELATORIO);
    const headers = ['Data/Hora', 'Assunto do Email', 'Total', 'Sucesso', 'Falhas', 'Detalhes dos Erros'];
    sheet.appendRow(headers);
    sheet.getRange("A1:F1").setFontWeight("bold").setBackground("#e0e0e0");
    sheet.setFrozenRows(1);
  }
  
  const dataHora = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
  const detalhesStr = detalhesArray.length > 0 ? detalhesArray.join(' | ') : "Sem erros";
  sheet.appendRow([dataHora, assunto, total, sucessos, erros, detalhesStr]);
  
  const lastRow = sheet.getLastRow();
  const corFundo = erros > 0 ? CONFIG.CORES_LOG.ERRO : CONFIG.CORES_LOG.SUCESSO;
  sheet.getRange(lastRow, 1, 1, 6).setBackground(corFundo);
}

// ====================================================================
// HELPERS
// ====================================================================

function gerarPreview(htmlEditor, assuntoEditor, index) {
  try {
    const dados = getSheetDataComFiltro();
    if (!dados || dados.length < 2) return { error: 'Nenhuma linha de dados disponível para visualização.' };
    
    const maxIndex = dados.length - 2;
    const safeIndex = Math.max(0, Math.min(index, maxIndex));
    const cabecalhos = dados[0];
    const linha = dados[safeIndex + 1]; 
    
    const indexEmail = identificarColunaEmail(cabecalhos);
    const celulaEmail = (indexEmail !== -1) ? String(linha[indexEmail]) : "";
    const emails = celulaEmail.split(/[;,]/).map(e => e.trim());

    return {
      index: safeIndex,
      total: dados.length - 1,
      para: (emails.length > 0 && emails[0] !== "") ? emails[0] : (indexEmail === -1 ? '⚠️ Coluna Email não encontrada' : 'Vazio'),
      cc: emails.length > 1 ? emails.slice(1).join(', ') : '-',
      htmlPreview: personalizarTexto(htmlEditor, cabecalhos, linha),
      assuntoPreview: personalizarTexto(assuntoEditor, cabecalhos, linha)
    };
  } catch (e) { 
    return { error: e.message };
  }
}

function personalizarTexto(texto, cabecalhos, linha) {
  if (!texto) return "";
  const mapaColunas = Object.create(null);
  
  cabecalhos.forEach((header, index) => {
    const chaveLimpa = String(header).replace(/<[^>]+>/g, "").trim().toLowerCase();
    mapaColunas[chaveLimpa] = index;
  });
  
  return texto.replace(/\{\{([\s\S]+?)\}\}/g, (match, conteudo) => {
    const chave = conteudo.replace(/<[^>]+>/g, "").replace(/&nbsp;/gi, " ").trim().toLowerCase();
    const index = mapaColunas[chave];

    if (index !== undefined) {
      const valor = linha[index];
      if (valor instanceof Date) {
        return Utilities.formatDate(valor, Session.getScriptTimeZone(), "dd/MM/yyyy");
      }
      return valor;
    }
    return CONFIG.MISSING_VAR_FALLBACK;
  });
}

function isValidEmail(email) { 
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

function identificarColunaEmail(cabecalhos) {
  const regex = /^(e[- ]?mail)$/i; 
  return cabecalhos.findIndex(h => regex.test(String(h).trim()));
}

function processarBlobs(anexosBase64) {
  if (!anexosBase64) return [];
  return anexosBase64.map(obj => 
    Utilities.newBlob(Utilities.base64Decode(obj.data), obj.type, obj.name)
  );
}

function prepararBlobsInline(listaImagens) {
  if (!listaImagens || listaImagens.length === 0) return {};
  const inlineImages = {};
  
  listaImagens.forEach(img => {
    const blob = Utilities.newBlob(Utilities.base64Decode(img.data), img.type, img.cid);
    inlineImages[img.cid] = blob;
  });
  
  return inlineImages;
}

function getAssinaturaGmail() {
  try {
    const response = Gmail.Users.Settings.SendAs.list('me');
    if (response.sendAs) {
      const contaPrincipal = response.sendAs.find(account => account.isPrimary);
      if (contaPrincipal && contaPrincipal.signature) {
        return { success: true, signature: contaPrincipal.signature };
      }
      return { success: false, message: "Nenhuma assinatura encontrada na conta Gmail principal." };
    }
    return { success: false, message: "Não foi possível localizar a assinatura do Gmail." };
  } catch (e) {
    return { success: false, message: "Não foi possível acessar a assinatura. Ative a API avançada do Gmail no Apps Script." };
  }
}

function getTrackingUrl() {
  const props = PropertiesService.getScriptProperties();
  const url = props.getProperty('URL_WEB_APP');
  return url || CONFIG.URL_WEB_APP;
}

function setTrackingUrl(url) {
  PropertiesService.getScriptProperties().setProperty('URL_WEB_APP', url || '');
}

function sanitizeFileName(nome) {
  return String(nome || '')
    .replace(/[\\/:*?"<>|#]+/g, '_')
    .replace(/\s+/g, ' ')
    .trim() || 'template';
}
